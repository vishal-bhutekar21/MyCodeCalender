<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strict HTTPS enforcement for production release -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Trusted API domain endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">leetcode.com</domain>
        <domain includeSubdomains="true">codeforces.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">github-contributions-api.jogruber.de</domain>
        <domain includeSubdomains="true">kontests.net</domain>
        <domain includeSubdomains="true">geeksforgeeks.org</domain>
        <domain includeSubdomains="true">codechef.com</domain>
        <domain includeSubdomains="true">atcoder.jp</domain>
    </domain-config>
</network-security-config>
